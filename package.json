{
  "name": "lazymise",
  "type": "module",
  "version": "2.1.1",
  "private": true,
  "packageManager": "bun@1.4.2",
  "bin": {
    "lazymise": "./src/main.js"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.js",
    "smoke:release": "bun scripts/smoke-release.js",
    "dev": "bun src/main.js",
    "test": "bun test --timeout 30000",
    "lint": "bun --bun eslint .",
    "format": "bun --bun oxfmt . && bun --bun eslint . --fix",
    "lint:fix": "bun --bun eslint . --fix"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/bun": "1.4.4",
    "eslint": "10.10.0",
    "oxfmt": "0.75.0"
  }
}
